{
  "name": "mxray-mcp-server",
  "version": "0.1.2",
  "description": "MCP Server for Xray Test Management (Jira Cloud)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mxray-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "samples",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timorek/mXray.git"
  },
  "author": "Arkadiusz Kłos (Timor) <klos.arkadiusz@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Timorek/mXray#readme",
  "keywords": [
    "mcp",
    "xray",
    "jira",
    "test-management",
    "model-context-protocol",
    "cursor",
    "claude",
    "github-copilot",
    "copilot",
    "testing",
    "qa"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
